# Godot
game/.godot/
game/.import/
*.translation
game/export.cfg
game/export_credentials.cfg
# Third-party binaries fetched by tools/fetch_deps.sh (pinned + checksummed)
game/addons/GodotApplePlugins*/
# Build output
build/
*.ipa
*.xcarchive
*.dSYM.zip
# Credentials — never commit
*.p8
*.p12
*.mobileprovision
*.cer
AuthKey_*.p8
.env
.env.*
# Local tool downloads
tools/.cache/
# OS
.DS_Store

# Python bytecode
__pycache__/
*.pyc
# Native extension binaries (built by tools/build_native.sh)
game/addons/ut_share/bin/
native/**/build/
